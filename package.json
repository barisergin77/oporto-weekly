{
  "name": "oporto-weekly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed-archive": "tsx scripts/seed-archive.ts",
    "extract-events": "tsx --env-file=.env.local scripts/extract-events-from-newsletter.ts",
    "fetch-event-images": "tsx --env-file=.env.local scripts/fetch-event-images.ts",
    "link-existing-newsletters": "tsx scripts/link-existing-newsletters.ts",
    "enrich-event-descriptions": "tsx --env-file=.env.local scripts/enrich-event-descriptions.ts",
    "validate-event-links": "tsx --env-file=.env.local scripts/validate-event-links.ts",
    "retranslate-pt": "tsx --env-file=.env.local scripts/retranslate-pt-newsletter.ts",
    "find-duplicates": "tsx scripts/find-duplicates.ts",
    "test:dedupe": "tsx scripts/test-dedupe.ts && tsx scripts/find-duplicates.ts --check > /dev/null",
    "test:compose": "tsx scripts/test-compose.ts",
    "test:leads": "tsx scripts/test-leads.ts",
    "test:fever": "tsx scripts/test-fever.ts",
    "test:gomry": "tsx scripts/test-gomry.ts",
    "test:gyg": "tsx scripts/test-gyg.ts",
    "test:picks": "tsx scripts/test-opus-picks.ts",
    "test:humanizer": "tsx scripts/test-humanizer.ts",
    "test:guides": "tsx scripts/test-related-guides.ts",
    "test:filters": "tsx scripts/test-event-filters.ts",
    "test:calendar": "tsx scripts/test-event-calendar.ts",
    "compose-dry-run": "tsx --env-file=.env.local scripts/compose-edition-dry-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "google-auth-library": "^10.6.2",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
